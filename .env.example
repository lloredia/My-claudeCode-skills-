# Copy to .env and fill in locally. .env is gitignored.
# Skills read these names from the environment. Do not commit real values.
#
# Skill-specific examples:
#   docs-writing/diary/.env.example
#   integrations-automation/telegram/assets/boilerplate/python/.env.example
#   integrations-automation/telegram/assets/boilerplate/nodejs/.env.example
#   integrations-automation/whatsapp-cloud-api/assets/boilerplate/python/.env.example
#   integrations-automation/whatsapp-cloud-api/assets/boilerplate/nodejs/.env.example
#
# last30days expects keys in ~/.config/last30days/.env (see that skill's README).

NOTION_TOKEN=
NOTION_DIARY_DB=
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
APP_SECRET=
VERIFY_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
